# Database
DATABASE_URL="postgresql://ats:ats@localhost:5432/ats?schema=public"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-me-in-production"

# Azure Communication Services (Email)
ACS_CONNECTION_STRING=""
ACS_SENDER_ADDRESS="DoNotReply@mail.ageri.no"

# Azure Web PubSub (in-app chat)
WEBPUBSUB_CONNECTION_STRING=""
WEBPUBSUB_HUB="ats"

# Azure Blob Storage (resumes, attachments)
BLOB_CONNECTION_STRING=""
BLOB_RESUMES_CONTAINER="resumes"
BLOB_ATTACHMENTS_CONTAINER="email-attachments"

# Seed
SEED_ADMIN_EMAIL="admin@ageri.no"
SEED_ADMIN_PASSWORD="Admin1234!"
